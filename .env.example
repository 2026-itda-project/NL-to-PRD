# Copy this file to .env at the repository root. Never commit .env.
# mock: no API calls; snowchat: real Gateway analysis.
LLM_PROVIDER=snowchat

# Personal SnowChat API Gateway key. Backend only.
FACTCHAT_API_KEY=

# Optional override. Empty uses https://factchat-cloud.mindlogic.ai/v1/gateway
SNOWCHAT_BASE_URL=

# Empty selects gpt-5.6-luna ONLY if returned by /models/.
# To override, use an exact model ID returned by your account's /models/.
SNOWCHAT_EXTRACTION_MODEL=
SNOWCHAT_GAP_MODEL=

# Optional: low / medium / high. Empty uses model defaults.
SNOWCHAT_EXTRACTION_REASONING=
SNOWCHAT_GAP_REASONING=
